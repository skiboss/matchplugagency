    # ============================================
# WordPress/Blog Configuration
# ============================================

# WordPress REST API URL
NEXT_PUBLIC_WORDPRESS_URL=https://matchplugagency.com/blog

# ============================================
# Email Configuration (SMTP)
# ============================================

# SMTP Server Settings
SMTP_HOST=your_smtp_host.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password

# Email sender address
SMTP_FROM=noreply@matchplugagency.com

# Email destination for contact form submissions
CONTACT_EMAIL_TO=admin@matchplugagency.com

# ============================================
# Setup Instructions
# ============================================

# WordPress Configuration:
# - NEXT_PUBLIC_WORDPRESS_URL: Your WordPress blog REST API URL
# - This is used to fetch blog posts and categories
# - The NEXT_PUBLIC_ prefix makes it accessible in the browser

# Email Configuration:
# Choose one of the options below:
#
# Option 1: Gmail SMTP (Recommended for Testing)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_app_password (from myaccount.google.com/apppasswords)
#
# Option 2: SendGrid
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxx
#
# Option 3: Custom SMTP Server
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587 or 465
#   SMTP_SECURE=false (for 587) or true (for 465)
#   SMTP_USER=your_email@yourdomain.com
#   SMTP_PASSWORD=your_password

